{
  "name": "ai-amc-nine-student-portal",
  "version": "1.0.0",
  "private": true,
  "description": "The AI AMC Nine Agentic AI Masterclass student community and learning portal.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "railway:start": "prisma migrate deploy && prisma db seed && next start"
  },
  "dependencies": {
